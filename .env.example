# ── Server ──
PORT=3001
NODE_ENV=development

# ── Database (dùng chung với vfc-fs) ──
DATABASE_URL=postgresql://user:pass@localhost:5432/vfc

# ── Redis ──
# Nếu dùng Upstash (rediss://):
REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379
# Nếu dùng local (Memurai/WSL2):
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ── AI Providers ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_API_VALIDATION_KEY=
OPENROUTER_MODEL=google/gemini-flash-1.5
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# ── Object Storage (Phase 3 mới cần) ──
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ── AI Config ──
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=3
AI_MAX_REFERENCE_ITEMS=7

# ── Worker ──
WORKER_CONCURRENCY=3

# ─── Google Drive Sync (Cho ca chẩn đoán lỗi / không có thuốc qua Google Apps Script Webhook) ───
ENABLE_GOOGLE_DRIVE_SYNC=true
GOOGLE_DRIVE_WEBHOOK_URL="https://script.google.com/macros/s/.../exec"
GOOGLE_DRIVE_FOLDER_ID="ID_THU_MUC_GOOGLE_DRIVE_CUA_BAN"